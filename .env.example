# AI Provider Configuration
# Set to 'gemini' or 'mock' (default: mock fallback if no API key is provided)
AI_PROVIDER=gemini

# Google Gemini API Key (optional - if omitted, mock intelligent customer support agent is used)
GEMINI_API_KEY=

# Company / Platform Branding
NEXT_PUBLIC_APP_NAME="OmniSupport AI"
NEXT_PUBLIC_COMPANY_NAME="Nexus Cloud Technologies"
